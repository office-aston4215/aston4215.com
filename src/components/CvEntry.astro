---
interface Props {
  title: string;
  subtitle?: string;
  location?: string;
  period: string;
  details: string[];
}

const { title, subtitle, location, period, details } = Astro.props;
const meta = [subtitle, location].filter(Boolean);
---

<article class="entry">
  <div class="heading">
    <h3>{title}</h3>
    <span class="period">{period}</span>
  </div>
  {meta.map((line) => <p class="meta">{line}</p>)}
  {details.length > 0 && <ul>{details.map((detail) => <li>{detail}</li>)}</ul>}
</article>

<style>
  .entry + .entry {
    margin-top: 32px;
  }

  .heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 24px;
  }

  h3 {
    min-width: 0;
    margin: 0;
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.016em;
    font-weight: 600;
  }

  .period {
    flex-shrink: 0;
    color: var(--muted);
    font: 400 14px/1.75 var(--mono);
    letter-spacing: 0;
  }

  .meta {
    margin-top: 2px;
    color: var(--muted);
  }

  ul {
    margin: 10px 0 0;
    padding-left: 1.1em;
  }

  li + li {
    margin-top: 6px;
  }

  @media (max-width: 767px) {
    .heading {
      flex-direction: column;
    }
  }
</style>
