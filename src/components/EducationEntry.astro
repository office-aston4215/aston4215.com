---
interface Props {
  school: string;
  location: string;
  period: string;
  details: string[];
}

const { school, location, period, details } = Astro.props;
---

<article class="entry">
  <div class="heading">
    <h3>{school}</h3>
    <span class="period">{period}</span>
  </div>
  <p class="location">{location}</p>
  {details.length > 0 && <ul>{details.map((detail) => <li>{detail}</li>)}</ul>}
</article>

<style>
  .entry + .entry {
    margin-top: 28px;
  }

  .heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 24px;
  }

  h3 {
    margin: 0;
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.016em;
    font-weight: 600;
  }

  .period {
    color: var(--muted);
    font: 400 14px/1.75 var(--mono);
    letter-spacing: 0;
    white-space: nowrap;
  }

  .location {
    margin-top: 2px;
    color: var(--muted);
  }

  ul {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 767px) {
    .heading {
      flex-direction: column;
    }
  }
</style>
