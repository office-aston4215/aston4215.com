---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article class="tile">
  <h3>{title}</h3>
  <slot />
</article>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(24px, 3vw, 36px);
    border-radius: 28px;
    background: var(--feature);
    color: var(--feature-text);
  }

  h3 {
    margin: 0;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.028em;
    font-weight: 600;
  }
</style>
