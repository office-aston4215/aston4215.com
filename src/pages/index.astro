---
import { getCollection, getEntry } from 'astro:content';
import ContactCard from '../components/ContactCard.astro';
import CvEntry from '../components/CvEntry.astro';
import Hero from '../components/Hero.astro';
import KvGraphic from '../components/KvGraphic.astro';
import LabCard from '../components/LabCard.astro';
import SpecBlock from '../components/SpecBlock.astro';
import SpecRow from '../components/SpecRow.astro';
import Tile from '../components/Tile.astro';
import Base from '../layouts/Base.astro';

const profile = (await getEntry('profile', 'main'))!.data;

const newestFirst = (a: { data: { start: string } }, b: { data: { start: string } }) => b.data.start.localeCompare(a.data.start);
const research = (await getCollection('research')).sort(newestFirst);
const publications = (await getCollection('publications')).sort(newestFirst);
const projects = (await getCollection('projects')).sort(newestFirst);
const education = (await getCollection('education')).sort(newestFirst);
const honors = (await getCollection('honors')).sort(newestFirst);
const experience = (await getCollection('experience')).sort(newestFirst);
const leadership = (await getCollection('leadership')).sort(newestFirst);
const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const contactCount = profile.emails.length + profile.links.length;
---

<Base title={profile.name} description={profile.lead.join(', ')}>
  <Hero name={profile.name} lead={profile.lead} />

  <section class="band" id="research">
    <div class="container">
      <h2 class="section-title">Research</h2>
      <Tile title={profile.research}>
        <KvGraphic />
      </Tile>
    </div>
  </section>

  <section class="band" id="labs">
    <div class="container">
      <h2 class="section-title">Labs</h2>
      <div class="lab-grid">
        {research.map(({ data }) => <LabCard {...data} />)}
      </div>
    </div>
  </section>

  <div class="container specs">
    {
      publications.length > 0 && (
        <SpecBlock id="publications" title="Publications">
          {publications.map(({ data }) => (
            <SpecRow label={data.period}>
              {data.url ? <a href={data.url}>{data.title}</a> : data.title}
              <span class="muted">{data.authors.join(', ')}</span>
              <span class="muted">{data.venue}</span>
            </SpecRow>
          ))}
        </SpecBlock>
      )
    }
    {
      projects.length > 0 && (
        <SpecBlock id="projects" title="Projects">
          {projects.map(({ data }) => (
            <SpecRow label={data.period}>
              {data.url ? <a href={data.url}>{data.title}</a> : data.title}
              <span class="muted">{data.summary}</span>
            </SpecRow>
          ))}
        </SpecBlock>
      )
    }
    <SpecBlock id="education" title="Education" as="div">
      {education.map(({ data }) => <CvEntry {...data} />)}
    </SpecBlock>
    <SpecBlock id="honors" title="Honors & Awards">
      {
        honors.map(({ data }) => (
          <SpecRow label={data.period}>
            {data.title}
            <span class="muted">{data.issuer}</span>
          </SpecRow>
        ))
      }
    </SpecBlock>
    <SpecBlock id="experience" title="Experience" as="div">
      {experience.map(({ data }) => <CvEntry {...data} />)}
    </SpecBlock>
    <SpecBlock id="leadership" title="Leadership & Service" as="div">
      {leadership.map(({ data }) => <CvEntry {...data} />)}
    </SpecBlock>
    <SpecBlock id="skills" title="Skills & Interests">
      {skills.map(({ data }) => <SpecRow label={data.label}>{data.value}</SpecRow>)}
    </SpecBlock>
  </div>

  <section class="band" id="contact">
    <div class="container">
      <h2 class="section-title">Contact</h2>
      <div class="contact-grid" style={`--columns: ${contactCount % 3 === 0 ? 3 : 2}`}>
        {profile.emails.map((email) => <ContactCard href={`mailto:${email.address}`} title={email.label} handle={email.address} icon="Email" />)}
        {profile.links.map((link) => <ContactCard href={link.url} title={link.label} handle={link.handle} icon={link.label} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .band {
    padding-block: clamp(56px, 7vw, 96px);
    background: var(--band);
  }

  .band + .band {
    padding-top: 0;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .specs {
    padding-block: clamp(56px, 7vw, 96px) clamp(24px, 4vw, 48px);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 899px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .lab-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 559px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
